CFS patch 1
# CFS (Claude's FirstStreetSynthesis) patch. One "<parameter id> = <value>" per line, values in
# the units shown in the comments. Ids are permanent (core/include/fss/synth/params.h); a file that
# leaves an id out gets that parameter's default. Text after '#' is a comment.
name = FM pad

# Global
1 = 5               # Algorithm (5 two stacks: A>B*, C>D*)
2 = -12.041201      # Output [dB]
3 = 440             # Tuning A4 [Hz]
4 = 2               # Bend range [st]

# Filter
10 = 1              # Filter [mode] (Low-pass)
11 = 3500           # Cutoff [Hz]
12 = 0.9            # Resonance [Q]
13 = 0              # Env amount [oct]
14 = 0.3            # Key track
15 = 0              # Vel > cutoff [oct]
16 = 1              # F attack [ms]
17 = 400            # F decay [ms]
18 = 0              # F sustain
19 = 300            # F release [ms]

# LFO 1 (vibrato)
30 = 4.8            # LFO1 rate [Hz]
31 = 0              # LFO1 shape (Sine)
32 = 400            # LFO1 delay [ms]
33 = 1200           # LFO1 fade [ms]
34 = 0              # LFO1 key sync (Off)
35 = 0.12           # Vibrato [st]
36 = 0.5            # Wheel > vib [st]

# LFO 2 (filter, index)
40 = 0.2            # LFO2 rate [Hz]
41 = 6              # LFO2 shape (Smooth random)
42 = 0              # LFO2 retrig (Off)
43 = 0.7            # LFO2 > cutoff [oct]
44 = 0.8            # LFO2 > index

# Voice
50 = 0              # Voice mode (Poly)
51 = 0              # Glide [ms]
52 = 1              # Glide legato (On)
53 = 0              # Priority (Last)

# Operator A
1000 = 2            # Ratio [x]
1001 = 4            # Detune [cents]
1002 = 0            # Fixed freq (Off)
1003 = 440          # Fixed Hz [Hz]
1004 = 1.4          # Level
1005 = 0            # Vel sens
1006 = 0            # Key level [dB/oct]
1007 = 0            # Key rate
1008 = 900          # Attack [ms]
1009 = 3000         # Decay [ms]
1010 = 0.7          # Sustain
1011 = 1500         # Release [ms]
1012 = 0            # Feedback

# Operator B
1100 = 1            # Ratio [x]
1101 = 0            # Detune [cents]
1102 = 0            # Fixed freq (Off)
1103 = 440          # Fixed Hz [Hz]
1104 = 0.5          # Level
1105 = 0            # Vel sens
1106 = 0            # Key level [dB/oct]
1107 = 0            # Key rate
1108 = 600          # Attack [ms]
1109 = 2000         # Decay [ms]
1110 = 0.9          # Sustain
1111 = 1800         # Release [ms]
1112 = 0            # Feedback

# Operator C
1200 = 3            # Ratio [x]
1201 = -5           # Detune [cents]
1202 = 0            # Fixed freq (Off)
1203 = 440          # Fixed Hz [Hz]
1204 = 1            # Level
1205 = 0            # Vel sens
1206 = 0            # Key level [dB/oct]
1207 = 0            # Key rate
1208 = 1500         # Attack [ms]
1209 = 4000         # Decay [ms]
1210 = 0.6          # Sustain
1211 = 1500         # Release [ms]
1212 = 0            # Feedback

# Operator D
1300 = 1            # Ratio [x]
1301 = 3            # Detune [cents]
1302 = 0            # Fixed freq (Off)
1303 = 440          # Fixed Hz [Hz]
1304 = 0.5          # Level
1305 = 0            # Vel sens
1306 = 0            # Key level [dB/oct]
1307 = 0            # Key rate
1308 = 800          # Attack [ms]
1309 = 3000         # Decay [ms]
1310 = 0.9          # Sustain
1311 = 2000         # Release [ms]
1312 = 0            # Feedback

end
