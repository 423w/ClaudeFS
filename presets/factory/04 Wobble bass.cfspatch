CFS patch 1
# CFS (Claude's FirstStreetSynthesis) patch. One "<parameter id> = <value>" per line, values in
# the units shown in the comments. Ids are permanent (core/include/fss/synth/params.h); a file that
# leaves an id out gets that parameter's default. Text after '#' is a comment.
name = Wobble bass

# Global
1 = 1               # Algorithm (1 stack: A>B>C>D*)
2 = -10.457574      # Output [dB]
3 = 440             # Tuning A4 [Hz]
4 = 2               # Bend range [st]

# Filter
10 = 1              # Filter [mode] (Low-pass)
11 = 400            # Cutoff [Hz]
12 = 6              # Resonance [Q]
13 = 0              # Env amount [oct]
14 = 0.5            # Key track
15 = 0              # Vel > cutoff [oct]
16 = 1              # F attack [ms]
17 = 300            # F decay [ms]
18 = 0              # F sustain
19 = 200            # F release [ms]

# LFO 1 (vibrato)
30 = 5              # LFO1 rate [Hz]
31 = 0              # LFO1 shape (Sine)
32 = 0              # LFO1 delay [ms]
33 = 0              # LFO1 fade [ms]
34 = 1              # LFO1 key sync (On)
35 = 0              # Vibrato [st]
36 = 0.5            # Wheel > vib [st]

# LFO 2 (filter, index)
40 = 3              # LFO2 rate [Hz]
41 = 1              # LFO2 shape (Triangle)
42 = 1              # LFO2 retrig (On)
43 = 2.5            # LFO2 > cutoff [oct]
44 = 0              # LFO2 > index

# Voice
50 = 0              # Voice mode (Poly)
51 = 0              # Glide [ms]
52 = 1              # Glide legato (On)
53 = 0              # Priority (Last)

# Delay
210 = 0             # Delay on (Off)
212 = 1             # Delay sync (On)
213 = 6             # Delay note (1/8 D)
211 = 375           # Delay time [ms]
214 = 35            # Delay feedback [%]
216 = 6000          # Delay damping [Hz]
215 = 1             # Delay ping-pong (On)
218 = 0             # Delay glide (Clean)
217 = 25            # Delay mix [%]

# Width
200 = 0             # Width on (Off)
201 = 100           # Width [%]

# Operator A
1000 = 1            # Ratio [x]
1001 = 0            # Detune [cents]
1002 = 0            # Fixed freq (Off)
1003 = 440          # Fixed Hz [Hz]
1004 = 0            # Level
1005 = 0            # Vel sens
1006 = 0            # Key level [dB/oct]
1007 = 0            # Key rate
1008 = 5            # Attack [ms]
1009 = 300          # Decay [ms]
1010 = 0.7          # Sustain
1011 = 300          # Release [ms]
1012 = 0            # Feedback

# Operator B
1100 = 1            # Ratio [x]
1101 = 0            # Detune [cents]
1102 = 0            # Fixed freq (Off)
1103 = 440          # Fixed Hz [Hz]
1104 = 0            # Level
1105 = 0            # Vel sens
1106 = 0            # Key level [dB/oct]
1107 = 0            # Key rate
1108 = 5            # Attack [ms]
1109 = 300          # Decay [ms]
1110 = 0.7          # Sustain
1111 = 300          # Release [ms]
1112 = 0            # Feedback

# Operator C
1200 = 1            # Ratio [x]
1201 = 0            # Detune [cents]
1202 = 0            # Fixed freq (Off)
1203 = 440          # Fixed Hz [Hz]
1204 = 3            # Level
1205 = 0.6          # Vel sens
1206 = 0            # Key level [dB/oct]
1207 = 0            # Key rate
1208 = 1            # Attack [ms]
1209 = 350          # Decay [ms]
1210 = 0.6          # Sustain
1211 = 80           # Release [ms]
1212 = 0.9          # Feedback

# Operator D
1300 = 1            # Ratio [x]
1301 = 0            # Detune [cents]
1302 = 0            # Fixed freq (Off)
1303 = 440          # Fixed Hz [Hz]
1304 = 1            # Level
1305 = 0.3          # Vel sens
1306 = 0            # Key level [dB/oct]
1307 = 0            # Key rate
1308 = 2            # Attack [ms]
1309 = 800          # Decay [ms]
1310 = 0.7          # Sustain
1311 = 60           # Release [ms]
1312 = 0            # Feedback

end
