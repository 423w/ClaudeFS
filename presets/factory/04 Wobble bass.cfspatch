CFS patch 1
# CFS (Claude's FirstStreetSynthesis) patch. One "<parameter id> = <value>" per line, values in
# the units shown in the comments. Ids are permanent (core/include/fss/synth/params.h); a file that
# leaves an id out gets that parameter's default. Text after '#' is a comment.
name = Wobble bass

# Global
1 = 1               # Algorithm (1 stack: A>B>C>D*)
2 = -10.457574      # Output [dB]
3 = 440             # Tuning A4 [Hz]
4 = 2               # Bend range [st]

# Filter
10 = 1              # Filter [mode] (Low-pass)
11 = 400            # Cutoff [Hz]
12 = 6              # Resonance [Q]
13 = 0              # Env amount [oct]
14 = 0.5            # Key track
15 = 0              # Vel > cutoff [oct]
16 = 1              # F attack [ms]
17 = 300            # F decay [ms]
18 = 0              # F sustain
19 = 200            # F release [ms]

# LFO 1 (vibrato)
30 = 5              # LFO1 rate [Hz]
31 = 0              # LFO1 shape (Sine)
32 = 0              # LFO1 delay [ms]
33 = 0              # LFO1 fade [ms]
34 = 1              # LFO1 key sync (On)
35 = 0              # Vibrato [st]
36 = 0.5            # Wheel > vib [st]

# LFO 2 (filter, index)
40 = 3              # LFO2 rate [Hz]
41 = 1              # LFO2 shape (Triangle)
42 = 1              # LFO2 retrig (On)
43 = 2.5            # LFO2 > cutoff [oct]
44 = 0              # LFO2 > index

# Voice
50 = 0              # Voice mode (Poly)
51 = 0              # Glide [ms]
