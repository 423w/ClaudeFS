218 = 0             # Delay glide (Clean)
217 = 25            # Delay mix [%]

# Width
200 = 1             # Width on (On)
201 = 130           # Width [%]

# Operator A
1000 = 14           # Ratio [x]
1001 = 0            # Detune [cents]
1002 = 0            # Fixed freq (Off)
1003 = 440          # Fixed Hz [Hz]
1004 = 1.6          # Level
1005 = 0.9          # Vel sens
1006 = 3            # Key level [dB/oct]
1007 = 0.5          # Key rate
1008 = 1            # Attack [ms]
1009 = 180          # Decay [ms]
1010 = 0            # Sustain
1011 = 100          # Release [ms]
1012 = 0            # Feedback

# Operator B
1100 = 1            # Ratio [x]
1101 = 0            # Detune [cents]
