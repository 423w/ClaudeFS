CFS patch 1
# CFS (Claude's FirstStreetSynthesis) patch. One "<parameter id> = <value>" per line, values in
# the units shown in the comments. Ids are permanent (core/include/fss/synth/params.h); a file that
# leaves an id out gets that parameter's default. Text after '#' is a comment.
name = E-piano chorus

# Global
1 = 5               # Algorithm (5 two stacks: A>B*, C>D*)
2 = -13.1515465     # Output [dB]
3 = 440             # Tuning A4 [Hz]
4 = 2               # Bend range [st]

# Filter
10 = 0              # Filter [mode] (Off)
11 = 2000           # Cutoff [Hz]
12 = 0.7071         # Resonance [Q]
13 = 0              # Env amount [oct]
14 = 0              # Key track
15 = 0              # Vel > cutoff [oct]
16 = 1              # F attack [ms]
17 = 400            # F decay [ms]
18 = 0              # F sustain
19 = 300            # F release [ms]

# LFO 1 (vibrato)
30 = 5              # LFO1 rate [Hz]
31 = 0              # LFO1 shape (Sine)
32 = 0              # LFO1 delay [ms]
33 = 0              # LFO1 fade [ms]
34 = 1              # LFO1 key sync (On)
35 = 0              # Vibrato [st]
36 = 0.5            # Wheel > vib [st]

# LFO 2 (filter, index)
40 = 2              # LFO2 rate [Hz]
41 = 0              # LFO2 shape (Sine)
42 = 0              # LFO2 retrig (Off)
43 = 0              # LFO2 > cutoff [oct]
44 = 0              # LFO2 > index

# Voice
50 = 0              # Voice mode (Poly)
51 = 0              # Glide [ms]
52 = 1              # Glide legato (On)
53 = 0              # Priority (Last)

# Chorus
220 = 1             # Chorus on (On)
221 = 0.5           # Chorus rate [Hz]
222 = 3.5           # Chorus depth [ms]
223 = 8             # Chorus delay [ms]
224 = 2             # Chorus voices
225 = 50            # Chorus mix [%]

# Flanger
230 = 0             # Flanger on (Off)
231 = 0.2           # Flanger rate [Hz]
232 = 0.5           # Flanger delay [ms]
233 = 3             # Flanger depth [ms]
234 = 50            # Flanger feedback [%]
235 = 50            # Flanger mix [%]

# Phaser
240 = 0             # Phaser on (Off)
241 = 0.3           # Phaser rate [Hz]
242 = 800           # Phaser center [Hz]
